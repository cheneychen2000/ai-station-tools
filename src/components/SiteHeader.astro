---
/**
 * 全站导航：直接复用 src/lib/nav.mjs 的 navHeaderHtml / navHeaderHtmlEn。
 *
 * 为什么保留函数式片段而不是重写成 Astro 标记：导航是"唯一结构来源"，
 * 既有检查（check-nav / check-i18n I5）逐字比对该函数的输出与产物；把结构搬到组件里
 * 会立刻产生第二套导航事实源。
 */
import { navHeaderHtml, navHeaderHtmlEn } from '../lib/nav.mjs';

interface Props {
  base: string;
  active?: string | null;
  crumb?: string;
  switchHref?: string | null;
  en?: boolean;
}
const { base, active = null, crumb = '', switchHref = null, en = false } = Astro.props;
const html = en ? navHeaderHtmlEn(base, active, crumb, switchHref) : navHeaderHtml(base, active, crumb, switchHref);
---
<Fragment set:html={html} />
