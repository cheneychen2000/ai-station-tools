---
/**
 * 全站 HTML 布局：旧 scripts/build.mjs 中 page() 的等价实现（head / 导航 / 页脚 / 脚本位）。
 *
 * 与原实现的差异仅限于"入口来自 Astro"：
 *  - depth / lang / canonicalPath 由当前路由推导（旧版由每个模板手写 depth 常量），
 *    因此相对资源前缀（base）与 canonical 永远与页面位置一致；
 *  - hreflang / 语言切换目标继续由 src/lib/locales.mjs 的路由映射派生（唯一事实来源不变）；
 *  - noindex 页面不输出 hreflang（沿用旧规则）。
 *
 * 为什么 SEO 头仍然拼接成一个字符串：字符串里每处动态值都经 esc() 转义（与旧模板逐字一致，
 * 含单引号 → &#39;）。若改用属性插值，Astro 只转义 & " < 而不转义单引号，会与迁移前产物产生
 * 字节差异，也会让 "元数据插值必须经 esc()" 这条结构断言失去意义。
 */
import { SITE, BRAND } from '../lib/paths.mjs';
import { routeMap } from '../lib/site.mjs';
import { hreflangPairs, switchTarget } from '../lib/locales.mjs';
import { esc, jsonld as toJsonLd } from '../lib/escape.mjs';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  title: string;
  desc?: string;
  /** 社交分享文案（历史手写页与页面 title/description 不一定相同，必须逐页保留原文） */
  ogTitle?: string;
  ogDescription?: string;
  /** og:type（指南类页面历史上为 article，其余 website） */
  ogType?: string;
  /** canonical 路径（缺省用当前路由，含尾部斜杠） */
  canonicalPath?: string;
  robots?: string | null;
  jsonld?: any[];
  active?: string | null;
  crumb?: string;
  /** 追加在 app.js 之后的内联脚本（生成页的埋点等） */
  inlineScript?: string;
}

const {
  title,
  desc = '',
  ogTitle = title,
  ogDescription = desc,
  ogType = 'website',
  canonicalPath,
  robots = null,
  jsonld: lds = [],
  active = null,
  crumb = '',
  inlineScript = ''
} = Astro.props;

const pathname = canonicalPath ?? Astro.url.pathname;
const lang = pathname === '/en/' || pathname.startsWith('/en/') ? 'en' : 'zh-CN';
/* 相对根前缀：/models/glm-53/ → '../../'（与原模板 depth 常量等价） */
const depth = pathname.split('/').filter(Boolean).length;
const base = '../'.repeat(depth);
/* noindex 页面不输出 hreflang：未索引页面无需语言对应声明 */
const altPairs = robots && robots.includes('noindex') ? [] : hreflangPairs(routeMap, pathname);
const switchHref = switchTarget(routeMap, pathname, lang === 'en' ? 'zh-CN' : 'en');

/* SEO 头（动态值，逐处经 esc()，与旧 page() 逐字节同形） */
const altLinks = altPairs.map(a => `  <link rel="alternate" hreflang="${esc(a.lang)}" href="${SITE}${esc(a.url)}">`).join('\n');
const headSeo = [
  `  <title>${esc(title)}</title>`,
  `  <meta name="description" content="${esc(desc)}">`,
  robots ? `  <meta name="robots" content="${esc(robots)}">` : '',
  `  <link rel="canonical" href="${SITE}${pathname}">`,
  altLinks,
  `  <meta property="og:type" content="${esc(ogType)}">`,
  `  <meta property="og:site_name" content="${esc(BRAND)}">`,
  `  <meta property="og:title" content="${esc(ogTitle)}">`,
  `  <meta property="og:description" content="${esc(ogDescription)}">`,
  `  <meta property="og:url" content="${SITE}${pathname}">`,
  `  <meta property="og:image" content="${SITE}/assets/og-cover.png">`
].filter(Boolean).join('\n');

/* JSON-LD：序列化与缩进与旧模板完全一致 */
const ld = lds.map(o => `  <script type="application/ld+json">\n${toJsonLd(o).split('\n').map(l => '  ' + l).join('\n')}\n  </script>`).join('\n');
const hasBodyEnd = Astro.slots.has('bodyend');
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <slot name="head-meta" />
  <Fragment set:html={headSeo} />
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">
  <link rel="stylesheet" href={`${base}assets/style.css`}>
  <Fragment set:html={ld} />
</head>
<body>
  <SiteHeader base={base} active={active} crumb={crumb} switchHref={switchHref} en={lang === 'en'} />

  <main class="wrap" id="main">
<slot />
  </main>

  <footer>
    <div class="wrap" id="site-footer">
      <SiteFooter base={base} en={lang === 'en'} />
    </div>
  </footer>

  {hasBodyEnd
    ? <slot name="bodyend" />
    : <Fragment set:html={`  <script>window.ASSETS_BASE = '${base}assets';</script>\n  <script src="${base}assets/app.js"></script>\n${inlineScript}`} />}
</body>
</html>
