---
/**
 * 全站导航（原生 Astro 模板）：菜单链接与文案复用 src/lib/nav.mjs 的导航配置
 * （NAV_ITEMS 仍是唯一事实来源），结构由本组件维护，不再经过 HTML 字符串函数。
 * 菜单项顺序/文案/active 高亮/语言切换器/汉堡按钮的 DOM 契约与迁移前逐字一致。
 */
import { NAV_ITEMS } from '../../lib/nav.mjs';
import { BRAND } from '../../lib/config';
import Breadcrumbs from '../seo/Breadcrumbs.astro';

interface Props {
  /** 相对根路径前缀（'' / '../' / '../../'），404 传 '/' 使用根绝对路径 */
  base: string;
  active?: string | null;
  crumb?: string;
  switchHref?: string | null;
  en?: boolean;
}

const { base, active = null, crumb = '', switchHref = null, en = false } = Astro.props;
/* 品牌链接承担"首页"入口（active==='home' 时高亮） */
const brandHref = en ? (base === '../' ? './' : `${base}en/`) : (base === '/' ? '/' : (base || './'));
const toggle = en
  ? { open: 'Open navigation menu', close: 'Close navigation menu' }
  : { open: '打开导航菜单', close: '关闭导航菜单' };
const lang = en
  ? { current: 'English', other: '中文', aria: 'Language: English, click to switch', menu: 'Select language' }
  : { current: '中文', other: 'English', aria: '语言：中文，点击切换语言', menu: '选择语言' };
---

<a class="skip-link" href="#main">{en ? 'Skip to content' : '跳到正文'}</a>
  <header class="topbar">
    <div class="wrap topbar-row">
      <a class="brand" href={brandHref} aria-current={active === 'home' ? 'page' : undefined}><img class="brand-logo" src={`${base}assets/logo.png`} alt={BRAND} width="160" height="39" /></a>
      <button type="button" class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="siteMenu" aria-label={toggle.open} data-label-open={toggle.open} data-label-close={toggle.close}><span class="nav-toggle-icon" aria-hidden="true"></span></button>
      <nav class="site-nav" aria-label={en ? 'Main navigation' : '主导航'}>
        <ul id="siteMenu">
          {NAV_ITEMS.map((it) => (
            <li><a href={`${base}${en ? it.pathEn : it.path}`} {...(active === it.key ? { class: 'active', 'aria-current': 'page' } : {})}>{en ? it.labelEn : it.label}</a></li>
          ))}
          {switchHref && (
          <li class="lang-switch-item">
            <div class="lang-switch-wrap">
              <button type="button" class="lang-btn" id="langBtn" aria-haspopup="true" aria-expanded="false" aria-controls="langMenu" aria-label={lang.aria}><svg class="lang-ico" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M1.9 8h12.2M8 1.9c1.7 1.8 2.5 3.9 2.5 6.1S9.7 12.3 8 14.1C6.3 12.3 5.5 10.2 5.5 8s.8-4.3 2.5-6.1Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg><span class="lang-cur">{lang.current}</span><svg class="lang-caret" viewBox="0 0 10 6" width="8" height="5" aria-hidden="true" focusable="false"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
              <ul class="lang-menu" id="langMenu" role="menu" aria-label={lang.menu}>
                <li class="lang-opt is-current" role="none"><span class="lang-opt-cur" role="menuitemradio" aria-checked="true" aria-current="true" tabindex="-1"><svg class="lang-check" viewBox="0 0 12 10" width="11" height="10" aria-hidden="true" focusable="false"><path d="M1 5.2 4.2 8.3 11 1.4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg><span>{lang.current}</span></span></li>
                <li class="lang-opt" role="none"><a class="lang-switch" href={switchHref} role="menuitemradio" aria-checked="false">{lang.other}</a></li>
              </ul>
              <noscript><style>.lang-btn{display:none}.lang-menu{display:block;position:static;margin-top:6px;box-shadow:none}</style></noscript>
            </div>
          </li>
          )}
        </ul>
      </nav>
    </div>
    {crumb && <Breadcrumbs crumb={crumb} />}
  </header>
