---
/**
 * ArticleMeta：发布时间 / 更新时间 / 作者（可选）/ 分类 / 标签。
 * 只展示 frontmatter 中真实存在的字段，不补造作者或日期。
 */
import type { ArticleSummary, GuideLang } from '../../lib/data/guides';
import { categoryLabel } from '../../lib/i18n/categories';

interface Props { article: ArticleSummary; lang: GuideLang }
const { article, lang } = Astro.props;
const en = lang === 'en';
const sameDay = article.publishedAt === article.updatedAt;
---
<p class="lib-meta article-meta">
  <span class="article-cat">{categoryLabel(article.category, lang)}</span>
  <span>{en ? 'Published ' : '发布于 '}{article.publishedAt}</span>
  {!sameDay && <span>{en ? 'Updated ' : '更新于 '}{article.updatedAt}</span>}
  {article.author && <span>{en ? 'By ' : '作者：'}{article.author}</span>}
  {article.tags.length > 0 && (
    <span class="m-tags">
      {article.tags.map(t => <span class="tag tag-feat">{t}</span>)}
    </span>
  )}
</p>

<style>
  .article-meta { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; margin: 10px 0 0; }
  .article-cat { border: 1px solid var(--line, #E2E7F0); border-radius: 999px; padding: 1px 10px; font-size: 12px; }
</style>
