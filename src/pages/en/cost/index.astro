---

<Layout title={"AI Model API Cost Calculator — Estimate Monthly Token Costs | Reflex Hub"}
  desc={"Estimate monthly LLM API costs from official list prices. Enter daily calls and token usage, weight by cache hit rate and off-peak rates, and compare DeepSeek, GLM, Kimi, Qwen, GPT, Claude and Gemini side by side."}
  ogDescription={"Enter daily calls and token usage to estimate monthly LLM API costs from official list prices, with cache-hit weighting and off-peak rates."}
  canonicalPath="/en/cost/"
  jsonld={[{"@context":"https://schema.org","@type":"SoftwareApplication","name":"LLM API Cost Calculator","url":"https://www.reflex-hub.com/en/cost/","applicationCategory":"UtilitiesApplication","operatingSystem":"Web","offers":{"@type":"Offer","price":"0","priceCurrency":"CNY"},"description":"Estimate monthly LLM API costs from vendors' published price lists, with cache-hit weighting and off-peak rates."},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How does this calculator work?","acceptedAnswer":{"@type":"Answer","text":"Monthly cost = calls per day × 30 × (input tokens ÷ 1,000,000 × effective input price + output tokens ÷ 1,000,000 × output price). The effective input price is weighted by cache hit rate: hit rate × cache-hit price + (1 − hit rate) × standard price. Models without a published cache price are billed at the standard input price."}},{"@type":"Question","name":"When do DeepSeek off-peak rates apply?","acceptedAnswer":{"@type":"Answer","text":"DeepSeek uses time-based pricing. Peak hours are weekdays 9:00–12:00 and 14:00–18:00; all other times (nights, early mornings, weekends and public holidays) use the off-peak rate, which is about half the peak rate. Scheduling batch jobs off-peak directly reduces cost."}},{"@type":"Question","name":"What does cache hit rate mean?","acceptedAnswer":{"@type":"Answer","text":"The cache hit rate is the share of input tokens that hit the context cache. Hit tokens are billed at a much lower cache-hit price; the rest are billed at the standard input price. Keeping a stable prompt prefix (such as a fixed system prompt) raises the hit rate and lowers input cost."}}]}]}
  active="cost"
  crumb={"/ Cost Calculator"}>
  <Fragment slot="bodyend" set:html={"\n\n  <script>\n    window.ASSETS_BASE = '../../assets';\n  </script>\n  <script src=\"../../assets/app.js\"></script>\n  <script src=\"../../assets/cost-core.js\"></script>\n  <script src=\"../../assets/labels-en.js\"></script>\n  <script>\n  (function () {\n    var DEFAULT_SELECTED = ['deepseek-v41-flash', 'glm-53-flash', 'qwen35-plus', 'kimi-k3'];\n    var STORE_KEY = 'rh_cost_state_en_v1';\n\n    var state = {\n      selected: DEFAULT_SELECTED.slice(),\n      calls: 100,\n      inTok: 2000,\n      outTok: 800,\n      offpeak: true,\n      cacheHit: 30\n    };\n\n    var models = [];\n    var FX = { usdCny: null, rateDate: null }; /* reference rate: excluded from conversion until verified */\n    function fxReady() { return typeof FX.usdCny === 'number' && FX.usdCny > 0 && !!FX.rateDate; }\n    function sym(m) { return (m.currency === 'USD') ? '$' : '¥'; }\n    function fmtCur(n, m) { return sym(m) + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }\n    function toCny(m, v) { return (m.currency === 'USD') ? (fxReady() ? v * FX.usdCny : null) : v; }\n    function fmtCny(v) { return '¥' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }\n    function fmtConv(m, v) {\n      var c = toCny(m, v);\n      if (c == null) return 'Reference rate unverified; conversion unavailable';\n      return (m.currency === 'USD') ? '≈ ' + fmtCny(c) + ' (converted at the ' + FX.rateDate + ' central parity rate, indicative only)' : fmtCny(c);\n    }\n\n    /* 展示字典：assets/labels-en.js（由 scripts/lib/i18n.mjs 构建生成，单一翻译来源，禁止页面内维护第二份） */\n    var L = window.EnLabels || { vendor: {}, modality: {}, feature: {}, tierDesc: [] };\n    var EN_VENDOR = L.vendor, EN_MODALITY = L.modality, EN_FEATURE = L.feature;\n    function en(s, dict) { return dict[s] || s; }\n    function enVendor(m) { return EN_VENDOR[m.vendor] || m.vendor; }\n    function enTierDesc(s) {\n      for (var i = 0; i < L.tierDesc.length; i++) s = s.split(L.tierDesc[i][0]).join(L.tierDesc[i][1]);\n      return s;\n    }\n\n    /* ---------- state persistence ---------- */\n    function saveState() {\n      try { localStorage.setItem(STORE_KEY, JSON.stringify(state)); } catch (e) { /* silent */ }\n    }\n    function loadState() {\n      try {\n        var raw = localStorage.getItem(STORE_KEY);\n        if (!raw) return;\n        var s = JSON.parse(raw);\n        if (s && typeof s === 'object') {\n          if (Array.isArray(s.selected)) state.selected = s.selected;\n          ['calls', 'inTok', 'outTok', 'cacheHit'].forEach(function (k) {\n            if (typeof s[k] === 'number' && isFinite(s[k]) && s[k] >= 0) state[k] = s[k];\n          });\n          if (typeof s.offpeak === 'boolean') state.offpeak = s.offpeak;\n        }\n      } catch (e) { /* silent */ }\n    }\n    /* deep link ?models=id1,id2 (takes precedence over local storage) */\n    function applyQueryModels() {\n      var m = /[?&]models=([a-z0-9,\\-]+)/i.exec(location.search);\n      if (!m) return;\n      var ids = m[1].split(',').filter(Boolean);\n      if (ids.length) state.selected = ids;\n    }\n\n    /* ---------- calculation: shared core (assets/cost-core.js), formula identical to the Chinese calculator ---------- */\n    function tierPrice(m, inTok) { return CostCore.tierPrice(m, inTok); }\n    function effectiveInputPrice(m, hitRatio) {\n      return CostCore.effectiveInputPrice(m, { offpeak: state.offpeak, inTok: state.inTok }, hitRatio);\n    }\n    function monthlyCost(m) {\n      var pr = effectiveInputPrice(m, state.cacheHit / 100);\n      if (!pr) return null;\n      return CostCore.monthlyCost(pr, state.calls, state.inTok, state.outTok);\n    }\n    function fmtMult(n) {\n      return n.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });\n    }\n\n    /* ---------- rendering ---------- */\n    var modelEls = {};\n    var collapsed = true;\n\n    function tagsHtml(m) {\n      var t = '';\n      (m.modalities || []).forEach(function (x) { t += '<span class=\"tag tag-mod\">' + en(x, EN_MODALITY) + '</span>'; });\n      (m.features || []).forEach(function (x) { t += '<span class=\"tag tag-feat\">' + en(x, EN_FEATURE) + '</span>'; });\n      return t ? '<span class=\"m-tags\">' + t + '</span>' : '';\n    }\n    function setSelected(id, on) {\n      var idx = state.selected.indexOf(id);\n      if (on && idx < 0) state.selected.push(id);\n      if (!on && idx >= 0) state.selected.splice(idx, 1);\n      var el = modelEls[id];\n      if (el) {\n        el.input.checked = on;\n        el.label.classList.toggle('checked', on);\n      }\n      renderChips();\n      onChange();\n    }\n    function renderChips() {\n      var box = document.getElementById('selChips');\n      box.innerHTML = '';\n      state.selected.forEach(function (id) {\n        var m = models.find(function (x) { return x.id === id; });\n        if (!m) return;\n        var chip = document.createElement('span');\n        chip.className = 'sel-chip';\n        chip.innerHTML = m.name + '<button type=\"button\" aria-label=\"Remove ' + m.name + '\">×</button>';\n        chip.querySelector('button').addEventListener('click', function () { setSelected(id, false); });\n        box.appendChild(chip);\n      });\n      box.style.visibility = state.selected.length ? 'visible' : 'hidden';\n    }\n    function toggleGrid() {\n      collapsed = !collapsed;\n      document.getElementById('modelGrid').classList.toggle('collapsed', collapsed);\n      document.getElementById('btnToggleModels').textContent =\n        collapsed ? 'Show all ' + models.length + ' models ▾' : 'Hide ▴';\n    }\n    function renderModelGrid() {\n      var grid = document.getElementById('modelGrid');\n      grid.innerHTML = '';\n      models.forEach(function (m) {\n        var label = document.createElement('label');\n        label.className = 'model-card' + (state.selected.indexOf(m.id) >= 0 ? ' checked' : '');\n        var s = sym(m);\n        var priceText = m.priceTiers\n          ? m.priceTiers.map(function (t) { return enTierDesc(t.desc) + (t.unverified ? ' rate not published' : ' In ' + s + t.priceIn + ' / Out ' + s + t.priceOut); }).join('<br>')\n          : m.peakOffpeak\n            ? 'Peak In ' + s + m.peakOffpeak.peakIn + ' / Out ' + s + m.peakOffpeak.peakOut + '<br>Off-peak In ' + s + m.peakOffpeak.offIn + ' / Out ' + s + m.peakOffpeak.offOut\n            : 'Input ' + s + m.priceIn + '<br>Output ' + s + m.priceOut;\n        label.innerHTML =\n          '<input type=\"checkbox\" value=\"' + m.id + '\"' + (state.selected.indexOf(m.id) >= 0 ? ' checked' : '') + '>' +\n          '<span class=\"m-info\">' +\n            '<span class=\"m-name\">' + m.name + (m.peakOffpeak ? '<span class=\"tag-peak\">Time-based</span>' : '') + '</span><br>' +\n            '<span class=\"m-vendor\">' + enVendor(m) + '</span>' + tagsHtml(m) +\n          '</span>' +\n          '<span class=\"m-price num\">' + priceText + '</span>';\n        label.querySelector('input').addEventListener('change', function (e) {\n          setSelected(e.target.value, e.target.checked);\n        });\n        modelEls[m.id] = { label: label, input: label.querySelector('input') };\n        grid.appendChild(label);\n      });\n      document.getElementById('btnToggleModels').textContent = 'Show all ' + models.length + ' models ▾';\n      document.getElementById('btnToggleModels').addEventListener('click', toggleGrid);\n    }\n\n    function renderResults() {\n      var area = document.getElementById('resultArea');\n      var ss = document.getElementById('stickySummary');\n      var picked = models.filter(function (m) { return state.selected.indexOf(m.id) >= 0; });\n      if (!picked.length) {\n        area.innerHTML = '<p class=\"empty-hint\">Select at least one model to compare costs</p>';\n        ss.classList.remove('show');\n        return;\n      }\n      var rows = picked.map(function (m) {\n        var c = monthlyCost(m);\n        return { model: m, total: c ? c.total : null, inCost: c ? c.inCost : null, outCost: c ? c.outCost : null, cny: c ? toCny(m, c.total) : null };\n      }).sort(function (a, b) {\n        if (a.cny == null && b.cny == null) return 0;\n        if (a.cny == null) return 1;\n        if (b.cny == null) return -1;\n        return a.cny - b.cny;\n      });\n\n      var okRows = rows.filter(function (r) { return r.cny != null; });\n      var min = okRows.length ? okRows[0].cny : null, max = okRows.length ? okRows[okRows.length - 1].cny : null;\n      var EPS = 0.005; /* treated as tied within display precision (0.01) */\n      var allTie = okRows.length > 1 && max - min < EPS;\n      var minCount = okRows.filter(function (r) { return r.cny - min < EPS; }).length;\n      var html = !okRows.length\n        ? '<div class=\"summary\">Costs for the selected models cannot be converted (reference rate unverified or tier rate not published)</div>'\n        : allTie\n          ? '<div class=\"summary\">The ' + okRows.length + ' selected models are tied at this usage (identical within display precision, all <span class=\"num\">' + fmtCny(min) + '/month</span>)</div>'\n          : '<div class=\"summary\">Cheapest: <b>' + okRows[0].model.name + '</b> (<span class=\"num\">' + fmtCny(min) + '/month</span>)' +\n            ' · priciest: <b>' + okRows[okRows.length - 1].model.name + '</b> (<span class=\"num\">' + fmtCny(max) + '/month</span>)' +\n            ' · <span class=\"num\">' + fmtMult(max / min) + '</span>× apart (all converted to CNY for comparison)</div>';\n\n      rows.forEach(function (r) {\n        var best = !allTie && r.cny != null && r.cny - min < EPS;\n        var tier = tierPrice(r.model, state.inTok);\n        var tierNote = tier && tier.desc ? ' (tier: ' + enTierDesc(tier.desc) + ')' : '';\n        var costMain = r.total == null\n          ? 'Tier rate not published; cannot estimate'\n          : fmtCur(r.total, r.model) + '<span style=\"font-size:13px;font-weight:400;color:var(--muted)\">/month</span>';\n        html += '<div class=\"result-card' + (best ? ' best' : '') + '\">' +\n          '<div class=\"r-head\">' +\n            '<span class=\"r-name\"><a class=\"r-name-link\" href=\"../models/' + r.model.id + '/\" title=\"View ' + r.model.name + ' profile\">' + r.model.name + '</a>' +\n              '<span class=\"r-vendor\">' + enVendor(r.model) + '</span>' +\n              (best ? '<span class=\"badge-best\">' + (minCount > 1 ? 'Tied for lowest' : 'Lowest cost for this usage') + '</span>' : '') +\n              tagsHtml(r.model) +\n            '</span>' +\n            '<span class=\"r-cost num\">' + costMain + '</span>' +\n          '</div>' +\n          '<div class=\"r-detail\">' +\n            (r.total == null ? '<span>The vendor has not published a rate for this input-length tier; lower tiers are not substituted</span>' :\n            '<span>Input cost <span class=\"num\">' + fmtCur(r.inCost, r.model) + '</span></span>' +\n            '<span>Output cost <span class=\"num\">' + fmtCur(r.outCost, r.model) + '</span></span>') +\n            (r.cny != null && r.model.currency === 'USD' ? '<span class=\"r-mult\">' + fmtConv(r.model, r.total) + '</span>' : '') +\n            (r.cny != null ? '<span class=\"r-mult\">' + (best ? (minCount > 1 ? 'Tied cheapest' : 'Cheapest') : '<span class=\"num\">' + fmtMult(r.cny / min) + '</span>× the lowest' + '') + tierNote + '</span>' : '') +\n          '</div>' +\n        '</div>';\n      });\n\n      html += '<p class=\"methodology\">Methodology: batching off-peak and keeping a stable prompt prefix (to raise cache hits) are two deterministic ways to cut cost; USD models are converted at a reference rate for comparison only.</p>';\n      html += '<p class=\"disclaimer\">Actual charges follow the vendor\\'s invoice. This result is for budgeting only.</p>';\n      html += '<div class=\"quiz-actions\" style=\"margin-top:14px\"><button type=\"button\" class=\"btn btn-ghost\" id=\"btnShareCalc\">Copy result to share</button></div>';\n      area.innerHTML = html;\n\n      var shareBtn = document.getElementById('btnShareCalc');\n      if (shareBtn) {\n        shareBtn.addEventListener('click', function () { shareResults(rows, min, max); });\n      }\n\n      ss.innerHTML = okRows.length\n        ? '<span>Cheapest <b>' + okRows[0].model.name + '</b> <span class=\"ss-num num\">' + fmtCny(min) + '/month</span></span><span class=\"ss-go\">View details ↓</span>'\n        : '<span>Selected models cannot be estimated yet</span>';\n      ss.classList.add('show');\n    }\n\n    /* ---------- copy & share ---------- */\n    function showToast(text) {\n      var t = document.getElementById('toast');\n      t.textContent = text;\n      t.classList.add('show');\n      clearTimeout(t._timer);\n      t._timer = setTimeout(function () { t.classList.remove('show'); }, 1600);\n    }\n    function copyText(text, done) {\n      if (navigator.clipboard && navigator.clipboard.writeText) {\n        navigator.clipboard.writeText(text).then(done, function () { legacyCopy(text, done); });\n      } else {\n        legacyCopy(text, done);\n      }\n    }\n    function legacyCopy(text, done) {\n      var ta = document.createElement('textarea');\n      ta.value = text;\n      ta.style.position = 'fixed';\n      ta.style.opacity = '0';\n      document.body.appendChild(ta);\n      ta.select();\n      try { document.execCommand('copy'); done(); } catch (e) { showToast('Copy failed, please select the text manually'); }\n      document.body.removeChild(ta);\n    }\n    function shareResults(rows, min, max) {\n      var okRows = rows.filter(function (r) { return r.cny != null; });\n      var EPS = 0.005;\n      var allTie = max - min < EPS;\n      var lines = ['[LLM API Monthly Cost Estimate]'];\n      lines.push('Usage: ' + state.calls + ' calls/day · ' + state.inTok + ' in / ' + state.outTok + ' out tokens per call · ' + (state.offpeak ? 'off-peak rates' : 'peak rates') + ' · cache hit ' + state.cacheHit + '%');\n      rows.forEach(function (r, i) {\n        if (r.total == null) { lines.push((i + 1) + '. ' + r.model.name + ': tier rate not published, cannot estimate'); return; }\n        lines.push((i + 1) + '. ' + r.model.name + ' ' + fmtCur(r.total, r.model) + '/month' + (r.model.currency === 'USD' ? ' (' + fmtConv(r.model, r.total) + ')' : '') + (!allTie && r.cny != null && r.cny - min < EPS ? ' ← lowest for this usage' : ''));\n      });\n      if (!okRows.length) {\n        lines.push('None of the selected models can be estimated.');\n      } else if (allTie) {\n        lines.push('All selected models are tied at this usage (' + fmtCny(min) + '/month).');\n      } else {\n        lines.push('Cheapest: ' + okRows[0].model.name + ' · priciest: ' + okRows[okRows.length - 1].model.name + ' · ' + fmtMult(max / min) + '× apart (CNY-converted basis).');\n      }\n      lines.push('Estimate: Reflex Hub reflex-hub.com/en/cost/ (free, no sign-up)');\n      copyText(lines.join('\\n'), function () {\n        showToast('Copied — paste it anywhere to share');\n        window.track('cost_share', { models: state.selected.slice() });\n      });\n    }\n\n    /* ---------- change tracking ---------- */\n    var trackTimer = null;\n    function onChange() {\n      saveState();\n      renderResults();\n      clearTimeout(trackTimer);\n      trackTimer = setTimeout(function () {\n        window.track('cost_calculate', {\n          models: state.selected.slice(),\n          peakOff: state.offpeak,\n          cacheHit: state.cacheHit\n        });\n      }, 1000);\n    }\n\n    function bindInputs() {\n      var calls = document.getElementById('inCalls');\n      var inTok = document.getElementById('inTokens');\n      var outTok = document.getElementById('outTokens');\n      var sw = document.getElementById('swOffpeak');\n      var rg = document.getElementById('rgCache');\n      var cacheVal = document.getElementById('cacheVal');\n\n      calls.value = state.calls;\n      inTok.value = state.inTok;\n      outTok.value = state.outTok;\n      sw.checked = state.offpeak;\n      rg.value = state.cacheHit;\n      cacheVal.textContent = state.cacheHit + '%';\n\n      function num(input, key) {\n        input.addEventListener('input', function () {\n          var v = parseFloat(input.value);\n          state[key] = (isFinite(v) && v >= 0) ? v : 0;\n          onChange();\n        });\n      }\n      num(calls, 'calls');\n      num(inTok, 'inTok');\n      num(outTok, 'outTok');\n      sw.addEventListener('change', function () { state.offpeak = sw.checked; onChange(); });\n      rg.addEventListener('input', function () {\n        state.cacheHit = parseInt(rg.value, 10) || 0;\n        cacheVal.textContent = state.cacheHit + '%';\n        onChange();\n      });\n    }\n\n    /* ---------- boot ---------- */\n    loadState();\n    Promise.all([\n      fetch('../../assets/data/models.json').then(function (res) { return res.json(); }),\n      fetch('../../assets/data/fx.json').then(function (res) { return res.json(); }).catch(function () { return null; })\n    ]).then(function (res) {\n      models = res[0];\n      var fx = res[1];\n      if (fx && fx.rates && fx.rates.USD_CNY && typeof fx.rates.USD_CNY.rate === 'number' && fx.rates.USD_CNY.rate > 0 && fx.rates.USD_CNY.rateDate) {\n        FX.usdCny = fx.rates.USD_CNY.rate;\n        FX.rateDate = fx.rates.USD_CNY.rateDate;\n      }\n      applyQueryModels();\n      state.selected = state.selected.filter(function (id) {\n        return models.some(function (m) { return m.id === id; });\n      });\n      renderModelGrid();\n      renderChips();\n      bindInputs();\n      var ss = document.getElementById('stickySummary');\n      ss.addEventListener('click', function () {\n        document.getElementById('resultArea').scrollIntoView({ behavior: 'smooth', block: 'start' });\n      });\n      renderResults();\n    }).catch(function () {\n      document.getElementById('resultArea').innerHTML =\n        '<p class=\"empty-hint\">Failed to load price data — please refresh</p>';\n    });\n  })();\n  </script>"} />
<section class="hero">
      <h1>AI Model API Cost Calculator</h1>
      <p class="tagline">Official list prices · off-peak rates · cache-hit weighting · USD converted at a verified reference rate</p>
    </section>

    <p class="lede">
      LLM API cost is driven by four variables: input tokens, output tokens, cache hit rate, and whether the vendor
      prices by time of day (peak vs off-peak). This tool applies your usage to each vendor's published price list
      and estimates a monthly cost in the original billing currency, so models can be compared on one screen.
      Prices are official list prices per 1M tokens in CNY or USD — they are not converted into USD unless the
      vendor bills in USD. Estimates are for budgeting and do not equal a vendor's invoice.
    </p>

    <section class="panel">
      <div class="panel-head">
        <h2>Select models (multi-select)</h2>
        <button type="button" class="toggle-models" id="btnToggleModels">Show all ▾</button>
      </div>
      <div class="selected-chips" id="selChips"></div>
      <div class="model-grid collapsed" id="modelGrid"></div>
    </section>

    <section class="panel">
      <h2>Your usage</h2>
      <div class="field-grid">
        <div class="field">
          <label for="inCalls">Calls per day</label>
          <input type="number" id="inCalls" min="0" step="100" value="100">
        </div>
        <div class="field">
          <label for="inTokens">Avg input tokens per call</label>
          <input type="number" id="inTokens" min="0" step="100" value="2000">
        </div>
        <div class="field">
          <label for="outTokens">Avg output tokens per call</label>
          <input type="number" id="outTokens" min="0" step="100" value="800">
        </div>
      </div>
      <div style="margin-top:16px">
        <div class="switch-row">
          <span class="switch">
            <input type="checkbox" id="swOffpeak" checked>
            <span class="slider-ui"></span>
          </span>
          <span class="s-label">Off-peak: price at the off-peak rate</span>
          <span class="s-hint">Only affects time-based priced models</span>
        </div>
        <div class="slider-row" style="margin-top:8px">
          <span class="s-label" style="white-space:nowrap">Cache hit rate</span>
          <input type="range" id="rgCache" min="0" max="100" step="1" value="30">
          <span class="s-val num" id="cacheVal">30%</span>
        </div>
        <p class="s-hint" style="margin-top:2px">Only applies to models with a published cache-hit price</p>
      </div>
    </section>

    <section class="panel">
      <h2>Reference: estimated monthly cost at default usage</h2>
      <p class="s-hint">Assumptions: 100 calls/day · 2,000 input tokens per call · 800 output tokens per call · off-peak rates on · 30% cache hit rate · 30-day month · amounts in the original billing currency (CNY). Results are estimates, not purchase advice.</p>
      
<Fragment set:html={costTableHtmlEn()} />

    </section>

    <section id="resultArea" aria-live="polite"></section>

    <section class="panel">
      <h2>Variables, formula and a worked example</h2>
      <div style="font-size:14px;line-height:1.9">
        <p><strong>Input tokens</strong>: the content sent to the model per call (including the system prompt and conversation history). <strong>Output tokens</strong>: the content the model generates. They are billed separately; output is usually priced higher than input.</p>
        <p><strong>Cache hit rate</strong>: the share of input tokens served from context cache, billed at the lower cache-hit price. It only applies to models with a published cache price; for the others the standard input price is used and no cache discount is assumed.</p>
        <p><strong>Off-peak (time-based pricing)</strong>: some vendors (e.g. DeepSeek) price by time of day. Outside peak hours — nights, lunch hours, weekends and public holidays — the off-peak rate is about half the peak rate.</p>
        <p><strong>Formula</strong>: monthly cost = calls/day × 30 days × (input tokens ÷ 1,000,000 × effective input price + output tokens ÷ 1,000,000 × output price), where effective input price = hit rate × cache-hit price + (1 − hit rate) × standard price. Prices are in each vendor's original currency (CNY or USD per 1M tokens); cross-currency comparison converts USD to CNY at a reference rate, which is indicative only.</p>
      </div>
      
<Fragment set:html={costExampleHtmlEn()} />

      <p class="s-hint">Not covered: free tiers, resource packs, subscription discounts and limited-time promos are not included; tiered models are estimated at the tier your input length falls into; an estimate is not a vendor's actual invoice and does not constitute purchase advice.</p>
    </section>

    <section class="panel">
      <h2>Frequently asked questions</h2>
      <h3 style="font-size:15px;margin:14px 0 6px">How does this calculator work?</h3>
      <p style="font-size:14px;line-height:1.8;color:var(--muted)">Monthly cost = calls per day × 30 × (input tokens ÷ 1,000,000 × effective input price + output tokens ÷ 1,000,000 × output price). The effective input price is weighted by cache hit rate: hit rate × cache-hit price + (1 − hit rate) × standard price. Models without a published cache price are billed at the standard input price.</p>
      <h3 style="font-size:15px;margin:14px 0 6px">When do DeepSeek off-peak rates apply?</h3>
      <p style="font-size:14px;line-height:1.8;color:var(--muted)">DeepSeek uses time-based pricing. Peak hours are weekdays 9:00–12:00 and 14:00–18:00; all other times (nights, early mornings, weekends and public holidays) use the off-peak rate, which is about half the peak rate. Scheduling batch jobs off-peak directly reduces cost.</p>
      <h3 style="font-size:15px;margin:14px 0 6px">What does cache hit rate mean?</h3>
      <p style="font-size:14px;line-height:1.8;color:var(--muted)">The cache hit rate is the share of input tokens that hit the context cache. Hit tokens are billed at a much lower cache-hit price; the rest are billed at the standard input price. Keeping a stable prompt prefix (such as a fixed system prompt) raises the hit rate and lowers input cost.</p>
