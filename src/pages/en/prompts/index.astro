---
/**
 * Prompt Library (/en/prompts/): 与中文库同一 prompts.json，英文文案经 i18n 字典服务端呈现。
 */
import Layout from '../../../layouts/SiteLayout.astro';
import { getPrompts } from '../../../lib/data';
import PromptCard from '../../../components/prompts/PromptCard.astro';

const prompts = await getPrompts();
---

<Layout title={"Prompt Library - Ready-to-Use AI Prompts for Everyday Tasks | Reflex Hub"}
  desc={"Explore ready-to-use AI prompts for writing, translation, coding, summarization, learning, and productivity. Copy a prompt and customize its placeholders to fit your needs."}
  ogDescription={"Explore practical AI prompts for writing, translation, coding, summarization, learning, and everyday productivity. Copy and customize prompts for your workflow."}
  canonicalPath="/en/prompts/"
  active="prompts"
  crumb={"/ Prompt Library"}>
  <Fragment slot="bodyend" set:html={"\n\n  <div class=\"toast\" id=\"toast\"></div>"} />
<section class="hero">
      <h1>Prompt library</h1>
      <p class="tagline">Chinese prompt templates for high-frequency scenarios, one-tap copy</p>
    </section>

    <p class="lede">
      Explore a collection of ready-to-use AI prompts for writing, translation, coding, summarization, learning, and
      everyday productivity. Choose a prompt, copy it into your preferred AI tool, and replace the bracketed
      placeholders with your own information. Each prompt includes clear instructions and output requirements to help
      you get more useful results. The language of the AI's final output depends on the instructions in the selected
      prompt.
    </p>

    <div id="promptList" data-copy-done="Copied" data-copy-fail="Copy failed, please select the text manually" data-lang="en">
      {prompts.map((p) => <PromptCard p={p} en />)}
    </div>

    <script>
      import '../../../scripts/prompts';
    </script>
</Layout>
