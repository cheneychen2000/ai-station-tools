---
/**
 * 手写页（迁移自 prompts/index.html，源码即产物 → Astro 源文件）。
 * 语言：zh-CN；标记注入区已改为 frontmatter 函数调用（同一数据源/同一公式）；
 * 联盟/广告占位注释原样保留，构建后由 placement 状态机重写。
 */
import Layout from '../../components/Layout.astro';
---

<Layout title={"Prompt 库 - 高频场景提示词，一键复制 | Reflex Hub"}
  desc={"写作、翻译、编程、总结、学习、办公高频场景的中文提示词模板，一键复制即用，把【占位符】换成你的内容即可。"}
  canonicalPath="/prompts/"
  active="prompts"
  crumb={"/ Prompt库"}>
  <Fragment slot="bodyend" set:html={"\n\n  <div class=\"toast\" id=\"toast\"></div>\n\n  <script>window.ASSETS_BASE = '../assets';</script>\n  <script src=\"../assets/app.js\"></script>\n  <script>\n  function showToast(text) {\n    var t = document.getElementById('toast');\n    t.textContent = text;\n    t.classList.add('show');\n    clearTimeout(t._timer);\n    t._timer = setTimeout(function () { t.classList.remove('show'); }, 1600);\n  }\n  function copyText(text, done) {\n    if (navigator.clipboard && navigator.clipboard.writeText) {\n      navigator.clipboard.writeText(text).then(done, function () { legacyCopy(text, done); });\n    } else {\n      legacyCopy(text, done);\n    }\n  }\n  function legacyCopy(text, done) {\n    var ta = document.createElement('textarea');\n    ta.value = text;\n    ta.style.position = 'fixed';\n    ta.style.opacity = '0';\n    document.body.appendChild(ta);\n    ta.select();\n    try { document.execCommand('copy'); done(); } catch (e) { showToast('复制失败，请手动选择文本'); }\n    document.body.removeChild(ta);\n  }\n\n  fetch('../assets/data/prompts.json').then(function (res) { return res.json(); }).then(function (prompts) {\n    var box = document.getElementById('promptList');\n    prompts.forEach(function (p) {\n      var card = document.createElement('div');\n      card.className = 'result-card';\n      card.innerHTML =\n        '<div class=\"r-head\">' +\n          '<span class=\"r-name\">' + p.title + '<span class=\"r-vendor\">' + p.scene + '</span></span>' +\n          '<button class=\"btn btn-primary btn-s copy-btn\" type=\"button\">复制</button>' +\n        '</div>' +\n        '<pre class=\"prompt-text\"></pre>' +\n        '<span class=\"m-tags\">' + (p.tags || []).map(function (t) { return '<span class=\"tag tag-feat\">' + t + '</span>'; }).join('') + '</span>';\n      card.querySelector('.prompt-text').textContent = p.prompt.zh;\n      card.querySelector('.copy-btn').addEventListener('click', function () {\n        copyText(p.prompt.zh, function () {\n          showToast('已复制');\n          window.track('prompt_copy', { id: p.id });\n        });\n      });\n      box.appendChild(card);\n    });\n  }).catch(function () {\n    document.getElementById('promptList').innerHTML = '<p class=\"empty-hint\">Prompt 数据加载失败，请刷新重试</p>';\n  });\n  </script>"} />
<section class="hero">
      <h1>Prompt 库</h1>
      <p class="tagline">高频场景提示词，一键复制即用</p>
    </section>

    <p class="lede">
      这里收录写作、翻译、编程、总结、学习、办公等高频场景的中文提示词模板。
      点「复制」后粘贴到任意 AI 对话工具，把【方括号占位符】换成你的内容即可。
      好 Prompt 的共同结构：角色 + 任务 + 约束 + 输出格式。
    </p>

    <div id="promptList"></div>
</Layout>
