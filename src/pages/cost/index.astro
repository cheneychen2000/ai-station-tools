---

<Layout title={"AI 大模型 API 成本计算器 - DeepSeek/GLM/Kimi/Qwen 比价 | Reflex Hub"}
  desc={"输入日均调用量与 Token 用量，一键估算 DeepSeek、GLM、Kimi、Qwen、GPT、Claude、Gemini 等国内外大模型 API 的每月成本，支持错峰低谷价与缓存命中率加权，数据定期核验。"}
  ogTitle={"AI大模型API成本计算器 - DeepSeek/GLM/Kimi/Qwen 比价 | Reflex Hub"}
  ogDescription={"输入日均调用量与 Token 用量，一键估算 DeepSeek、GLM、Kimi、Qwen、GPT、Claude、Gemini 等国内外大模型 API 的每月成本，支持错峰低谷价与缓存命中率加权。"}
  canonicalPath="/cost/"
  jsonld={[{"@context":"https://schema.org","@type":"SoftwareApplication","name":"AI大模型API成本计算器","url":"https://www.reflex-hub.com/cost/","applicationCategory":"UtilitiesApplication","operatingSystem":"Web","offers":{"@type":"Offer","price":"0","priceCurrency":"CNY"},"description":"按厂商公开价目估算大模型 API 月成本，支持错峰低谷价与缓存命中率加权。"},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"这个计算器怎么算？","acceptedAnswer":{"@type":"Answer","text":"月成本 = 日均调用次数 × 30 ×（单次输入Token数 ÷ 100万 × 输入有效单价 + 单次输出Token数 ÷ 100万 × 输出单价）。输入有效单价按缓存命中率加权：命中率 × 缓存命中价 +（1 - 命中率）× 未命中价；未公开缓存价的模型直接按未命中价计。"}},{"@type":"Question","name":"DeepSeek 低谷价什么时候适用？","acceptedAnswer":{"@type":"Answer","text":"DeepSeek 采用分时段定价，高峰时段为工作日 9:00-12:00 与 14:00-18:00，其余时段（夜间、凌晨、节假日全天）适用低谷价。低谷价约为高峰价的一半，把批量任务调度到低谷时段即可直接降本。"}},{"@type":"Question","name":"缓存命中率是什么意思？","acceptedAnswer":{"@type":"Answer","text":"缓存命中率指请求中命中上下文缓存的输入 Token 比例。命中部分按远低于标准价的缓存价计费，未命中部分按标准输入价计费。保持稳定的Prompt前缀（如固定系统提示词）可显著提高命中率，从而降低输入成本。"}}]}]}
  active="cost"
  crumb={"/ 成本计算器"}>
  <Fragment slot="bodyend" set:html={"\n\n  <script>\n    window.ASSETS_BASE = '../assets';\n  </script>\n  <script src=\"../assets/app.js\"></script>\n  <script src=\"../assets/cost-core.js\"></script>\n  <script>\n  (function () {\n    var DEFAULT_SELECTED = ['deepseek-v41-flash', 'glm-53-flash', 'qwen35-plus', 'kimi-k3'];\n    var STORE_KEY = 'aih_cost_state_v1';\n    var Calc = window.CostCore; /* 公式唯一实现源：assets/cost-core.js（与 /en/cost/ 及 pricing.mjs 对拍一致） */\n\n    var state = {\n      selected: DEFAULT_SELECTED.slice(),\n      calls: 100,\n      inTok: 2000,\n      outTok: 800,\n      offpeak: true,\n      cacheHit: 30\n    };\n\n    var models = [];\n    var FX = { usdCny: null, rateDate: null }; /* 参考汇率：未核实不参与折算 */\n    function fxReady() { return typeof FX.usdCny === 'number' && FX.usdCny > 0 && !!FX.rateDate; }\n    function sym(m) { return (m.currency === 'USD') ? '$' : '¥'; }\n    function fmtCur(n, m) { return sym(m) + n.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }\n    function toCny(m, v) { return (m.currency === 'USD') ? (fxReady() ? v * FX.usdCny : null) : v; }\n    function fmtCny(v) { return '¥' + v.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }\n    function fmtConv(m, v) {\n      var c = toCny(m, v);\n      if (c == null) return '参考汇率未核实，无法折算';\n      return (m.currency === 'USD') ? '约 ' + fmtCny(c) + '（按 ' + FX.rateDate + ' 中间价折算，仅供参考）' : fmtCny(c);\n    }\n\n    /* ---------- 状态持久化 ---------- */\n    function saveState() {\n      try { localStorage.setItem(STORE_KEY, JSON.stringify(state)); } catch (e) { /* 静默 */ }\n    }\n    function loadState() {\n      try {\n        var raw = localStorage.getItem(STORE_KEY);\n        if (!raw) return;\n        var s = JSON.parse(raw);\n        if (s && typeof s === 'object') {\n          if (Array.isArray(s.selected)) state.selected = s.selected;\n          ['calls', 'inTok', 'outTok', 'cacheHit'].forEach(function (k) {\n            if (typeof s[k] === 'number' && isFinite(s[k]) && s[k] >= 0) state[k] = s[k];\n          });\n          if (typeof s.offpeak === 'boolean') state.offpeak = s.offpeak;\n        }\n      } catch (e) { /* 静默 */ }\n    }\n    /* ?models=id1,id2 深链预勾选（优先级高于本地存储） */\n    function applyQueryModels() {\n      var m = /[?&]models=([a-z0-9,\\-]+)/i.exec(location.search);\n      if (!m) return;\n      var ids = m[1].split(',').filter(Boolean);\n      if (ids.length) state.selected = ids;\n    }\n\n    /* ---------- 计算 ---------- */\n    /* 条件价档 / 有效单价 / 月成本：委托共享核心 CostCore（assets/cost-core.js），公式与英文版及 pricing.mjs 完全一致 */\n    function tierPrice(m, inTok) { return Calc.tierPrice(m, inTok); }\n    function effectiveInputPrice(m, hitRatio) {\n      return Calc.effectiveInputPrice(m, { offpeak: state.offpeak, inTok: state.inTok }, hitRatio);\n    }\n    function monthlyCost(m) {\n      var pr = effectiveInputPrice(m, state.cacheHit / 100);\n      if (!pr) return null;\n      return Calc.monthlyCost(pr, state.calls, state.inTok, state.outTok);\n    }\n    function fmt(n) {\n      return '¥' + n.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n    }\n    function fmtMult(n) {\n      return n.toLocaleString('zh-CN', { minimumFractionDigits: 1, maximumFractionDigits: 1 });\n    }\n\n    /* ---------- 渲染 ---------- */\n    var modelEls = {};\n    var collapsed = true;\n\n    function tagsHtml(m) {\n      var t = '';\n      (m.modalities || []).forEach(function (x) { t += '<span class=\"tag tag-mod\">' + x + '</span>'; });\n      (m.features || []).forEach(function (x) { t += '<span class=\"tag tag-feat\">' + x + '</span>'; });\n      return t ? '<span class=\"m-tags\">' + t + '</span>' : '';\n    }\n    function setSelected(id, on) {\n      var idx = state.selected.indexOf(id);\n      if (on && idx < 0) state.selected.push(id);\n      if (!on && idx >= 0) state.selected.splice(idx, 1);\n      var el = modelEls[id];\n      if (el) {\n        el.input.checked = on;\n        el.label.classList.toggle('checked', on);\n      }\n      renderChips();\n      onChange();\n    }\n    function renderChips() {\n      var box = document.getElementById('selChips');\n      box.innerHTML = '';\n      state.selected.forEach(function (id) {\n        var m = models.find(function (x) { return x.id === id; });\n        if (!m) return;\n        var chip = document.createElement('span');\n        chip.className = 'sel-chip';\n        chip.innerHTML = m.name + '<button type=\"button\" aria-label=\"移除 ' + m.name + '\">×</button>';\n        chip.querySelector('button').addEventListener('click', function () { setSelected(id, false); });\n        box.appendChild(chip);\n      });\n      box.style.visibility = state.selected.length ? 'visible' : 'hidden';\n    }\n    function toggleGrid() {\n      collapsed = !collapsed;\n      document.getElementById('modelGrid').classList.toggle('collapsed', collapsed);\n      document.getElementById('btnToggleModels').textContent =\n        collapsed ? '展开全部 ' + models.length + ' 款 ▾' : '收起 ▴';\n    }\n    function renderModelGrid() {\n      var grid = document.getElementById('modelGrid');\n      grid.innerHTML = '';\n      models.forEach(function (m) {\n        var label = document.createElement('label');\n        label.className = 'model-card' + (state.selected.indexOf(m.id) >= 0 ? ' checked' : '');\n        var s = sym(m);\n        var priceText = m.priceTiers\n          ? m.priceTiers.map(function (t) { return t.desc + (t.unverified ? ' 费率未公开' : ' 入' + s + t.priceIn + '/出' + s + t.priceOut); }).join('<br>')\n          : m.peakOffpeak\n            ? '高峰 入' + s + m.peakOffpeak.peakIn + '/出' + s + m.peakOffpeak.peakOut + '<br>低谷 入' + s + m.peakOffpeak.offIn + '/出' + s + m.peakOffpeak.offOut\n            : '输入 ' + s + m.priceIn + '<br>输出 ' + s + m.priceOut;\n        label.innerHTML =\n          '<input type=\"checkbox\" value=\"' + m.id + '\"' + (state.selected.indexOf(m.id) >= 0 ? ' checked' : '') + '>' +\n          '<span class=\"m-info\">' +\n            '<span class=\"m-name\">' + m.name + (m.peakOffpeak ? '<span class=\"tag-peak\">分时段</span>' : '') + '</span><br>' +\n            '<span class=\"m-vendor\">' + m.vendor + '</span>' + tagsHtml(m) +\n          '</span>' +\n          '<span class=\"m-price num\">' + priceText + '</span>';\n        label.querySelector('input').addEventListener('change', function (e) {\n          setSelected(e.target.value, e.target.checked);\n        });\n        modelEls[m.id] = { label: label, input: label.querySelector('input') };\n        grid.appendChild(label);\n      });\n      document.getElementById('btnToggleModels').textContent = '展开全部 ' + models.length + ' 款 ▾';\n      document.getElementById('btnToggleModels').addEventListener('click', toggleGrid);\n    }\n\n    function renderResults() {\n      var area = document.getElementById('resultArea');\n      var ss = document.getElementById('stickySummary');\n      var picked = models.filter(function (m) { return state.selected.indexOf(m.id) >= 0; });\n      if (!picked.length) {\n        area.innerHTML = '<p class=\"empty-hint\">请至少选择一款模型</p>';\n        ss.classList.remove('show');\n        return;\n      }\n      var rows = picked.map(function (m) {\n        var c = monthlyCost(m);\n        return { model: m, total: c ? c.total : null, inCost: c ? c.inCost : null, outCost: c ? c.outCost : null, cny: c ? toCny(m, c.total) : null };\n      }).sort(function (a, b) {\n        if (a.cny == null && b.cny == null) return 0;\n        if (a.cny == null) return 1;\n        if (b.cny == null) return -1;\n        return a.cny - b.cny;\n      });\n\n      var okRows = rows.filter(function (r) { return r.cny != null; });\n      var min = okRows.length ? okRows[0].cny : null, max = okRows.length ? okRows[okRows.length - 1].cny : null;\n      var EPS = 0.005; /* 展示精度（0.01 元）内视为持平，不突出任何一方 */\n      var allTie = okRows.length > 1 && max - min < EPS;\n      var minCount = okRows.filter(function (r) { return r.cny - min < EPS; }).length;\n      var html = !okRows.length\n        ? '<div class=\"summary\">所选模型的估算成本均无法折算（参考汇率未核实或档位费率未公开）</div>'\n        : allTie\n          ? '<div class=\"summary\">所选 ' + okRows.length + ' 款模型在该用量下的估算月成本持平（展示精度内相同，均为 <span class=\"num\">' + fmtCny(min) + '/月</span>）</div>'\n          : '<div class=\"summary\">最省的是 <b>' + okRows[0].model.name + '</b>（<span class=\"num\">' + fmtCny(min) + '/月</span>）' +\n            '，最贵的是 <b>' + okRows[okRows.length - 1].model.name + '</b>（<span class=\"num\">' + fmtCny(max) + '/月</span>）' +\n            '，相差 <span class=\"num\">' + fmtMult(max / min) + '</span> 倍（统一按人民币折算口径）</div>';\n\n      rows.forEach(function (r, i) {\n        var best = !allTie && r.cny != null && r.cny - min < EPS;\n        var tier = tierPrice(r.model, state.inTok);\n        var tierNote = tier && tier.desc ? '（' + tier.desc + ' 档费率）' : '';\n        var costMain = r.total == null\n          ? '该档位费率未公开，无法估算'\n          : fmtCur(r.total, r.model) + '<span style=\"font-size:13px;font-weight:400;color:var(--muted)\">/月</span>';\n        html += '<div class=\"result-card' + (best ? ' best' : '') + '\">' +\n          '<div class=\"r-head\">' +\n            '<span class=\"r-name\"><a class=\"r-name-link\" href=\"../models/' + r.model.id + '/\" title=\"查看 ' + r.model.name + ' 档案\">' + r.model.name + '</a>' +\n              '<span class=\"r-vendor\">' + r.model.vendor + '</span>' +\n              (best ? '<span class=\"badge-best\">' + (minCount > 1 ? '并列最低' : '该用量下成本最低') + '</span>' : '') +\n              tagsHtml(r.model) +\n            '</span>' +\n            '<span class=\"r-cost num\">' + costMain + '</span>' +\n          '</div>' +\n          '<div class=\"r-detail\">' +\n            (r.total == null ? '<span>官方未公布该输入长度档位费率，不套用低档价格</span>' :\n            '<span>输入成本 <span class=\"num\">' + fmtCur(r.inCost, r.model) + '</span></span>' +\n            '<span>输出成本 <span class=\"num\">' + fmtCur(r.outCost, r.model) + '</span></span>') +\n            (r.cny != null && r.model.currency === 'USD' ? '<span class=\"r-mult\">' + fmtConv(r.model, r.total) + '</span>' : '') +\n            (r.cny != null ? '<span class=\"r-mult\">' + (best ? (minCount > 1 ? '并列最便宜' : '最便宜') : '为最低价的 <span class=\"num\">' + fmtMult(r.cny / min) + '</span> 倍') + tierNote + '</span>' : '') +\n          '</div>' +\n        '</div>';\n      });\n\n      html += '<p class=\"methodology\">方法论：低谷跑批 + 稳定前缀（提升缓存命中）是两类确定性降本手段；美元模型按参考汇率折算参与比价，折算值仅供参考。</p>';\n      html += '<p class=\"disclaimer\">实际费用以厂商账单为准，本结果仅供预算参考。</p>';\n      html += '<div class=\"quiz-actions\" style=\"margin-top:14px\"><button type=\"button\" class=\"btn btn-ghost\" id=\"btnShareCalc\">复制结果，分享给朋友</button></div>';\n      area.innerHTML = html;\n\n      var shareBtn = document.getElementById('btnShareCalc');\n      if (shareBtn) {\n        shareBtn.addEventListener('click', function () { shareResults(rows, min, max); });\n      }\n\n      ss.innerHTML = okRows.length\n        ? '<span>最省 <b>' + okRows[0].model.name + '</b> <span class=\"ss-num num\">' + fmtCny(min) + '/月</span></span><span class=\"ss-go\">查看明细 ↓</span>'\n        : '<span>所选模型暂无法折算估算</span>';\n      ss.classList.add('show');\n    }\n\n    /* ---------- 结果复制分享 ---------- */\n    function showToast(text) {\n      var t = document.getElementById('toast');\n      t.textContent = text;\n      t.classList.add('show');\n      clearTimeout(t._timer);\n      t._timer = setTimeout(function () { t.classList.remove('show'); }, 1600);\n    }\n    function copyText(text, done) {\n      if (navigator.clipboard && navigator.clipboard.writeText) {\n        navigator.clipboard.writeText(text).then(done, function () { legacyCopy(text, done); });\n      } else {\n        legacyCopy(text, done);\n      }\n    }\n    function legacyCopy(text, done) {\n      var ta = document.createElement('textarea');\n      ta.value = text;\n      ta.style.position = 'fixed';\n      ta.style.opacity = '0';\n      document.body.appendChild(ta);\n      ta.select();\n      try { document.execCommand('copy'); done(); } catch (e) { showToast('复制失败，请手动选择文本'); }\n      document.body.removeChild(ta);\n    }\n    function shareResults(rows, min, max) {\n      var okRows = rows.filter(function (r) { return r.cny != null; });\n      var EPS = 0.005;\n      var allTie = max - min < EPS;\n      var lines = ['【AI大模型 API 月成本估算】'];\n      lines.push('用量：日均 ' + state.calls + ' 次调用 · 单次输入 ' + state.inTok + ' / 输出 ' + state.outTok + ' Token · 错峰' + (state.offpeak ? '（低谷价）' : '（高峰价）') + ' · 缓存命中率 ' + state.cacheHit + '%');\n      rows.forEach(function (r, i) {\n        if (r.total == null) { lines.push((i + 1) + '. ' + r.model.name + '：档位费率未公开，无法估算'); return; }\n        lines.push((i + 1) + '. ' + r.model.name + ' ' + fmtCur(r.total, r.model) + '/月' + (r.model.currency === 'USD' ? '（' + fmtConv(r.model, r.total) + '）' : '') + (!allTie && r.cny != null && r.cny - min < EPS ? ' ← 该用量下成本最低' : ''));\n      });\n      if (!okRows.length) {\n        lines.push('所选模型均无法折算估算。');\n      } else if (allTie) {\n        lines.push('所选模型在该用量下估算月成本持平（' + fmtCny(min) + '/月）。');\n      } else {\n        lines.push('最省的是 ' + okRows[0].model.name + '，最贵的是 ' + okRows[okRows.length - 1].model.name + '，相差 ' + fmtMult(max / min) + ' 倍（人民币折算口径）。');\n      }\n      lines.push('测算：Reflex Hub reflex-hub.com/cost/（免费免注册）');\n      copyText(lines.join('\\n'), function () {\n        showToast('已复制，去粘贴分享吧');\n        window.track('cost_share', { models: state.selected.slice() });\n      });\n    }\n\n    /* ---------- 变更与埋点 ---------- */\n    var trackTimer = null;\n    function onChange() {\n      saveState();\n      renderResults();\n      clearTimeout(trackTimer);\n      trackTimer = setTimeout(function () {\n        window.track('cost_calculate', {\n          models: state.selected.slice(),\n          peakOff: state.offpeak,\n          cacheHit: state.cacheHit\n        });\n      }, 1000);\n    }\n\n    function bindInputs() {\n      var calls = document.getElementById('inCalls');\n      var inTok = document.getElementById('inTokens');\n      var outTok = document.getElementById('outTokens');\n      var sw = document.getElementById('swOffpeak');\n      var rg = document.getElementById('rgCache');\n      var cacheVal = document.getElementById('cacheVal');\n\n      calls.value = state.calls;\n      inTok.value = state.inTok;\n      outTok.value = state.outTok;\n      sw.checked = state.offpeak;\n      rg.value = state.cacheHit;\n      cacheVal.textContent = state.cacheHit + '%';\n\n      function num(input, key) {\n        input.addEventListener('input', function () {\n          var v = parseFloat(input.value);\n          state[key] = (isFinite(v) && v >= 0) ? v : 0;\n          onChange();\n        });\n      }\n      num(calls, 'calls');\n      num(inTok, 'inTok');\n      num(outTok, 'outTok');\n      sw.addEventListener('change', function () { state.offpeak = sw.checked; onChange(); });\n      rg.addEventListener('input', function () {\n        state.cacheHit = parseInt(rg.value, 10) || 0;\n        cacheVal.textContent = state.cacheHit + '%';\n        onChange();\n      });\n    }\n\n    /* ---------- 启动 ---------- */\n    loadState();\n    Promise.all([\n      fetch('../assets/data/models.json').then(function (res) { return res.json(); }),\n      fetch('../assets/data/fx.json').then(function (res) { return res.json(); }).catch(function () { return null; })\n    ]).then(function (res) {\n      models = res[0];\n      var fx = res[1];\n      if (fx && fx.rates && fx.rates.USD_CNY && typeof fx.rates.USD_CNY.rate === 'number' && fx.rates.USD_CNY.rate > 0 && fx.rates.USD_CNY.rateDate) {\n        FX.usdCny = fx.rates.USD_CNY.rate;\n        FX.rateDate = fx.rates.USD_CNY.rateDate;\n      }\n      applyQueryModels();\n      state.selected = state.selected.filter(function (id) {\n        return models.some(function (m) { return m.id === id; });\n      });\n      renderModelGrid();\n      renderChips();\n      bindInputs();\n      var ss = document.getElementById('stickySummary');\n      ss.addEventListener('click', function () {\n        document.getElementById('resultArea').scrollIntoView({ behavior: 'smooth', block: 'start' });\n      });\n      renderResults();\n    }).catch(function () {\n      document.getElementById('resultArea').innerHTML =\n        '<p class=\"empty-hint\">价格数据加载失败，请刷新重试</p>';\n    });\n  })();\n  </script>"} />
<section class="hero">
      <h1>AI 大模型 API 成本计算器</h1>
      <p class="tagline">国内外主流模型 · 错峰低谷价 · 缓存命中率加权 · 美元按中间价折算</p>
    </section>

    <p class="lede">
      大模型 API 的成本由四个变量决定：输入 Token 量、输出 Token 量、缓存命中率，以及厂商是否分时段定价（高峰/低谷）。
      本工具按各厂商公开价目，代入你的实际用量，估算每款模型的每月人民币成本，便于横向比价。
      计算原理、单位换算与常见误区见指南<a href="../guides/llm-api-cost/">《如何计算 LLM API 成本》</a>；
      价格数据的来源与核验口径见<a href="../pricing-methodology/">定价方法论</a>。
    </p>

    <section class="panel">
      <div class="panel-head">
        <h2>选择模型（可多选）</h2>
        <button type="button" class="toggle-models" id="btnToggleModels">展开全部 ▾</button>
      </div>
      <div class="selected-chips" id="selChips"></div>
      <div class="model-grid collapsed" id="modelGrid"></div>
    </section>

    <section class="panel">
      <h2>你的用量</h2>
      <div class="field-grid">
        <div class="field">
          <label for="inCalls">日均调用次数</label>
          <input type="number" id="inCalls" min="0" step="100" value="100">
        </div>
        <div class="field">
          <label for="inTokens">单次平均输入 Token</label>
          <input type="number" id="inTokens" min="0" step="100" value="2000">
        </div>
        <div class="field">
          <label for="outTokens">单次平均输出 Token</label>
          <input type="number" id="outTokens" min="0" step="100" value="800">
        </div>
      </div>
      <div style="margin-top:16px">
        <div class="switch-row">
          <span class="switch">
            <input type="checkbox" id="swOffpeak" checked>
            <span class="slider-ui"></span>
          </span>
          <span class="s-label">错峰：按低谷价计算</span>
          <span class="s-hint">仅影响分时段定价的模型</span>
        </div>
        <div class="slider-row" style="margin-top:8px">
          <span class="s-label" style="white-space:nowrap">缓存命中率</span>
          <input type="range" id="rgCache" min="0" max="100" step="1" value="30">
          <span class="s-val num" id="cacheVal">30%</span>
        </div>
        <p class="s-hint" style="margin-top:2px">仅对有公开缓存价的模型生效</p>
      </div>
    </section>

    <section class="panel">
      <h2>默认用量下的模型月成本参考</h2>
      <p class="s-hint">估算口径：日均调用 100 次 · 单次平均输入 2000 Token · 单次平均输出 800 Token · 错峰（低谷价）启用 · 缓存命中率 30% · 月度按 30 天估算 · 金额以人民币计。结果仅为估算，不构成采购建议。</p>
      
<Fragment set:html={costTableHtml()} />

    </section>

    <section id="resultArea" aria-live="polite"></section>

    <section class="panel">
      <h2>计算变量、公式与示例</h2>
      <div style="font-size:14px;line-height:1.9">
        <p><strong>输入 Token</strong>：每次调用发送给模型的内容量（含系统提示词与历史对话）；<strong>输出 Token</strong>：模型生成的内容量。两者分开计价，输出价通常高于输入价。</p>
        <p><strong>缓存命中率</strong>：输入中命中上下文缓存的比例，命中部分按更低的缓存命中价计费；仅对有公开缓存价的模型生效，未公开的模型按未命中价计，不假设缓存折扣。</p>
        <p><strong>错峰（峰谷定价）</strong>：部分厂商（如 DeepSeek）分时段计价，高峰时段外（夜间、午间、周末与法定节假日全天）按约为高峰一半的低谷价计费。</p>
        <p><strong>计算公式</strong>：月成本 = 日均调用 × 30 天 ×（单次输入 Token ÷ 1,000,000 × 输入有效单价 + 单次输出 Token ÷ 1,000,000 × 输出单价），其中输入有效单价 = 命中率 × 缓存命中价 +（1 − 命中率）× 未命中价。价格单位为各厂商官方原币种（人民币或美元 / 百万 Token），跨币种比价时按参考汇率折算为人民币，折算值仅供参考。</p>
      </div>
      
<Fragment set:html={costExampleHtml()} />

      <p class="s-hint">不适用情形：估算基于上述固定假设，未计入免费额度、资源包、套餐折扣与限免活动；分档计价模型按页面标注档位估算；估算不等于服务商实际账单，不构成采购建议。</p>
    </section>

    <section class="panel">
      <h2>常见问题</h2>
      <h3 style="font-size:15px;margin:14px 0 6px">这个计算器怎么算？</h3>
      <p style="font-size:14px;line-height:1.8;color:var(--muted)">月成本 = 日均调用次数 × 30 ×（单次输入Token数 ÷ 100万 × 输入有效单价 + 单次输出Token数 ÷ 100万 × 输出单价）。输入有效单价按缓存命中率加权：命中率 × 缓存命中价 +（1 - 命中率）× 未命中价；未公开缓存价的模型直接按未命中价计。</p>
      <h3 style="font-size:15px;margin:14px 0 6px">DeepSeek 低谷价什么时候适用？</h3>
      <p style="font-size:14px;line-height:1.8;color:var(--muted)">DeepSeek 采用分时段定价，高峰时段为工作日 9:00-12:00 与 14:00-18:00，其余时段（夜间、凌晨、节假日全天）适用低谷价。低谷价约为高峰价的一半，把批量任务调度到低谷时段即可直接降本。</p>
      <h3 style="font-size:15px;margin:14px 0 6px">缓存命中率是什么意思？</h3>
      <p style="font-size:14px;line-height:1.8;color:var(--muted)">缓存命中率指请求中命中上下文缓存的输入 Token 比例。命中部分按远低于标准价的缓存价计费，未命中部分按标准输入价计费。保持稳定的Prompt前缀（如固定系统提示词）可显著提高命中率，从而降低输入成本。</p>
    </section>

    <div class="sticky-summary" id="stickySummary" role="button" tabindex="0"></div>
    <div class="toast" id="toast"></div>
</Layout>
