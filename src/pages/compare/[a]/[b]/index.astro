---
/**
 * 中文对比页（/compare/<a>/<b>/）：组合清单来自 manifest.comparePairs（a<b 归一，17 款全组合 136 组）。
 * 与旧构建同一数据源、同一组合、同一 pricing 公式。
 */
import Layout from '../../../../components/Layout.astro';
import { models, pairs } from '../../../../lib/site.mjs';
import { compareDetail } from '../../../../lib/render.mjs';

export function getStaticPaths() {
  return pairs.map(([a, b]) => ({ params: { a, b }, props: { a, b } }));
}

const ma = models.find(x => x.id === Astro.props.a);
const mb = models.find(x => x.id === Astro.props.b);
if (!ma || !mb) throw new Error(`compare models not found: ${Astro.props.a}/${Astro.props.b}`);
const p = compareDetail(ma, mb);
---

<Layout
  title={p.title}
  desc={p.desc}
  canonicalPath={p.canonicalPath}
  robots={p.robots}
  jsonld={p.jsonld}
  active={p.active}
  crumb={p.crumb}
  inlineScript={p.inlineScript}
>
  <Fragment set:html={p.main} />
</Layout>
