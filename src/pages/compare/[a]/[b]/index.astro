---
/**
 * 中文对比页（/compare/<a>/<b>/）：组合来自全模型两两全组合（a<b 归一，136 组），
 * 与迁移前同一数据源、同一组合、同一 pricing 公式与判定逻辑。
 */
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { getSiteData } from '../../../../lib/data';
import { buildCompareView } from '../../../../lib/domain/compare-view';
import CompareTable from '../../../../components/compare/CompareTable.astro';
import CompareSummary from '../../../../components/compare/CompareSummary.astro';

export async function getStaticPaths() {
  const { pairs } = await getSiteData();
  return pairs.map(([a, b]) => ({ params: { a, b }, props: { a, b } }));
}

const { models, fx } = await getSiteData();
const ma = models.find(x => x.id === Astro.props.a);
const mb = models.find(x => x.id === Astro.props.b);
if (!ma || !mb) throw new Error(`compare models not found: ${Astro.props.a}/${Astro.props.b}`);
const view = buildCompareView(ma, mb, fx, false);
---

<SiteLayout
  title={view.title}
  desc={view.desc}
  canonicalPath={view.canonicalPath}
  jsonld={view.jsonld}
  active={view.active}
  crumb={view.crumb}
  inlineScript={view.inlineScript}
>
    <section class="hero" style="text-align:left;padding-bottom:0">
      <h1 style="font-size:26px">{view.aName} <span style="color:var(--muted);font-weight:400">vs</span> {view.bName}</h1>
      <p class="tagline">{view.aVendor} vs {view.bVendor} · 价格与规格逐项对比</p>
    </section>

    <p class="lede">{view.lede}</p>

    <CompareTable view={view} />

    <CompareSummary view={view} />

    <div class="cta-row">
      <a class="btn btn-primary" href={`../../../cost/?models=${ma.id},${mb.id}`} onclick={`window.track('compare_to_cost', { a: '${ma.id}', b: '${mb.id}' })`}>按你的用量精确算 →</a>
      <a class="btn btn-ghost" href={`../../../models/${ma.id}/`}>{view.cta.aProfile}</a>
      <a class="btn btn-ghost" href={`../../../models/${mb.id}/`}>{view.cta.bProfile}</a>
    </div>
</SiteLayout>
